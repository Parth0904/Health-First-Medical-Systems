# Public site URL used for canonical metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://healthfirstmed.in

# Email integration (existing)
RESEND_API_KEY=

# Private Sales Assistant Authentication
# Generate a random 64-char hex secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALES_AUTH_SECRET=

# JSON array (or base64-encoded JSON array) of authorized sales accounts.
# Generate securely with: node scripts/hash-sales-password.mjs
SALES_AUTH_USERS=

# Optional session lifetime in seconds (default: 28800 = 8 hours, min: 60, max: 604800)
SALES_SESSION_TTL_SECONDS=28800

